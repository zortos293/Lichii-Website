{
  "name": "lichii-compatibility",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:prepare": "node --env-file-if-exists=.env --import tsx server/prepare.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/static": "^10.1.8",
    "@tailwindcss/vite": "^4.1.18",
    "fastify": "^5.7.0",
    "lucide-react": "^0.577.0",
    "oauth4webapi": "^3.8.5",
    "postgres": "^3.4.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "glob": "^14.0.3"
  }
}
